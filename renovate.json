{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>securesign/renovate-config//org-inherited-config.json"],
  "enabledManagers": ["dockerfile", "gomod", "tekton", "custom.regex"],
  "ignorePaths": [
    "Containerfile{,}",
    "Containerfile.pkcs11",
    "examples/**",
    ".github/workflows/**"
  ],
  "packageRules": [
    {
      "description": "Skip images used only by the upstream Containerfiles",
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang", "debian", "gcr.io/distroless/base-debian12"],
      "enabled": false
    }
  ]
}
